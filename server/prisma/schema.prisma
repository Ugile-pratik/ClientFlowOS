datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  password                 String
  fullName                 String
  isVerified               Boolean   @default(false)
  verificationToken        String?   @db.VarChar(255)
  verificationTokenExpiry  DateTime?
  resetPasswordToken       String?   @db.VarChar(255)
  resetPasswordTokenExpiry DateTime?

  // Professional Profile Info
  profilePhotoUrl          String?
  coverBannerUrl           String?
  phone                    String?
  location                 String?
  profession               String?
  bio                      String?   @db.Text
  skills                   Json?
  experienceLevel          String?
  hourlyRate               Float?
  website                  String?
  linkedIn                 String?
  github                   String?

  // Business Profile Info
  businessName             String?
  businessType             String?
  gstNumber                String?
  businessAddress          String?   @db.Text
  businessDescription      String?   @db.Text

  // Payment & Invoicing Settings
  upiId                    String?
  paymentQrUrl             String?
  paymentInstructions      String?   @db.Text
  invoicePrefix            String?   @default("INV")
  nextInvoiceNumber        Int?      @default(1)
  defaultCurrency          String?   @default("INR")
  defaultTaxRate           Float?    @default(0)
  defaultPaymentTerms      String?   @default("Due within 15 days")
  defaultNotes             String?   @db.Text
  invoiceLogoUrl           String?
  invoiceColor             String?   @default("#1976d2")
  showAddressOnInvoice     Boolean?  @default(true)
  showPhoneOnInvoice       Boolean?  @default(true)
  showEmailOnInvoice       Boolean?  @default(true)
  showWebsiteOnInvoice     Boolean?  @default(true)

  // Security & Preferences & Notifications
  theme                    String?   @default("system")
  dateFormat               String?   @default("DD/MM/YYYY")
  timeZone                 String?   @default("Asia/Kolkata")
  notifyProjectDeadlines   Boolean?  @default(true)
  notifyInvoiceDue         Boolean?  @default(true)
  notifyPaymentReceived    Boolean?  @default(true)
  notifyAiInsights         Boolean?  @default(true)

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  clients                  Client[]
}

model Client {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String?
  name        String
  email       String
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  gstNumber   String?
  notes       String?      @db.Text
  status      String       @default("Lead")
  tags        Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projects    Project[]
  aiInsights  AI_Insight[]

  @@unique([userId, email])
}

model Project {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  budget    Float
  dueDate   DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
}

model Invoice {
  id            Int      @id @default(autoincrement())
  projectId     Int
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())
  dueDate       DateTime
  items         Json?
  subtotal      Float?   @default(0)
  taxRate       Float?   @default(0)
  taxAmount     Float?   @default(0)
  discount      Float?   @default(0)
  amount        Float
  notes         String?  @db.Text
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid    Float
  paymentDate   DateTime @default(now())
  paymentMethod String
  referenceId   String?
  notes         String?
}

model AI_Insight {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insightType String
  message     String   @db.Text
  createdAt   DateTime @default(now())
}
